# Tickerline Production Environment Template
# NEVER commit real private keys or production secrets to source control.

# Application Runtime
NODE_ENV="production"
PORT=3000
APP_URL="https://tickerline.com"
RUN_SERVER="true"

# PostgreSQL Database Configuration
POSTGRES_USER="tickerline_admin"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_RANDOM_PASSWORD"
POSTGRES_DB="tickerline_db"
DATABASE_URL="postgresql://tickerline_admin:REPLACE_WITH_STRONG_RANDOM_PASSWORD@localhost:5432/tickerline_db"

# Session & JWT Cryptographic Secrets
JWT_SECRET="GENERATE_64_CHAR_HEX_SECRET_openssl_rand_hex_32"
SESSION_SECRET="GENERATE_ANOTHER_64_CHAR_HEX_SECRET"

# Feature Flags
VITE_ENABLE_DEMO_MODE="false"

# Oracle & Price Feeds (Chainlink Aggregator / CoinGecko)
CHAINLINK_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
CHAINLINK_USDT_USD_FEED="0x0A6513e40db6EB1b165753C82f547762543d3F29"

# Institutional Custody & Blockchain Provider (Fireblocks / BitGo / Circle)
# (Keep empty until provider contract execution and AML/KYC review)
MPC_PROVIDER_API_KEY=""
MPC_PROVIDER_SECRET=""
VAULT_ACCOUNT_ID=""

# Tokenized Consumer Verification Providers
# Plaid / Argyle / Pinwheel
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="production"

# Email Delivery (SendGrid / AWS SES)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SENDGRID_API_KEY"
EMAIL_FROM="disclosures@tickerline.com"
